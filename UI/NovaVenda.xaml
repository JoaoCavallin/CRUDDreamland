<Window x:Class="UI.NovaVenda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nova Venda"
        MinHeight="720" MinWidth="1024"
        Height="720" Width="1024"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= CLIENTE ================= -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="10">

            <TextBlock Text="Cliente:" FontWeight="Bold"/>
            <TextBlock Name="blockNomeCliente" Text="Não Informado" Margin="10,0"/>

            <TextBlock Text="CPF:" Margin="30,0,0,0" FontWeight="Bold"/>
            <TextBlock Name="blockCpfCliente" Text="Não Informado" Margin="10,0"/>

        </StackPanel>

        <!-- ================= PRODUTO ================= -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="10">
            <Label Content="Código do Produto"/>
            <TextBox Name="boxCodProduto"
                     KeyUp="boxCodProduto_KeyUp"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
            <Label Content="Produto"/>
            <TextBlock Name="blockNomeProduto"
                       Text="Nenhum produto selecionado"
                       FontWeight="Bold"/>
        </StackPanel>

        <!-- ================= QUANTIDADE ================= -->
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="10">
            <Label Content="Quantidade (Enter)"/>
            <TextBox Name="boxQuantidade"
                     KeyUp="boxQuantidade_KeyUp"/>
        </StackPanel>

        <!-- ================= GRID ================= -->
        <DataGrid Name="gridVendaProduto"
          Grid.Row="3"
          Grid.ColumnSpan="2"
          AutoGenerateColumns="False"
          AlternationCount="{Binding Items.Count, RelativeSource={RelativeSource Self}}">

            <DataGrid.Columns>

                <DataGridTextColumn Header="#"
            Binding="{Binding AlternationIndex, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
            Width="0.5*"/>

                <DataGridTextColumn Header="Código Produto"
                            Binding="{Binding ProdutoId}"
                            Width="1.2*"/>

                <DataGridTextColumn Header="Nome"
                            Binding="{Binding ProdutoNome}"
                            Width="2*"/>

                <DataGridTextColumn Header="Preço"
                            Binding="{Binding Preco}"
                            Width="1*"/>

                <DataGridTextColumn Header="Quantidade"
                            Binding="{Binding QuantidadeProduto}"
                            Width="1*"/>

                <DataGridTextColumn Header="Total"
                            Binding="{Binding Total}"
                            Width="1*"/>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= TOTAL + BOTÕES ================= -->
        <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Total -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <TextBlock Text="Total:" FontSize="18" FontWeight="Bold"/>
                <TextBlock Name="blockTotal"
                           Text="0.00"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="10,0"/>

            </StackPanel>

            <!-- Botões -->
            <StackPanel Orientation="Horizontal" Grid.Column="1">

                <Button Content="Cancelar"
                        Width="140"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button Name="ConfirmarVenda"
                        Content="Confirmar Venda"
                        Width="180"
                        Click="btnConfirmarVenda"/>

            </StackPanel>

        </Grid>

    </Grid>
</Window>