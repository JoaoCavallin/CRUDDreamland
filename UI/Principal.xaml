<Window x:Class="UI.Principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        MinHeight="720"
        MinWidth="1024"
        Height="720"
        Width="1024"
        WindowStartupLocation="CenterScreen"
        Title="DreamLand">

    <Grid>

        <!-- Fundo -->
        <Grid.Background>
            <ImageBrush ImageSource="/Copy of DreamLand.png"/>
        </Grid.Background>

        <!-- Card principal -->
        <Border
            Margin="25"
            Padding="20"
            CornerRadius="18"
            Background="Transparent"
            Opacity="0.97">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra superior -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">

                        <TextBlock
                            Text="Usuário Atual:"
                            FontWeight="SemiBold"
                            Margin="0,0,8,0"/>

                        <TextBlock
                            Name="BoxUsuarioAtual"
                            Text="NOME USUARIO CONECTADO"
                            FontWeight="Bold"
                            Foreground="#5A4DCC"/>

                    </StackPanel>

                </Grid>

                <!-- Titulo -->
                <Image
                 Source="/DreamLand__2_-removebg-preview.png"
                 Height="80"
                 HorizontalAlignment="Center"
                 Margin="0,20,0,10"/>

                <!-- Tabs -->
                <TabControl
                    Grid.Row="2"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0">

                    <!-- TAB PRODUTO -->
                    <TabItem Header="Produto" FontSize="18" FontWeight="Bold">

                        <Grid Margin="10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Botões -->
                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">

                                <Button
                                    Content="Consultar Produtos"
                                    Width="160"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnConsultarProduto"/>

                                <Button
                                    Content="Excluir Produto"
                                    Width="140"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnExcluirProduto"/>

                                <Button
                                    Content="Editar Produto"
                                    Width="140"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="btnEditarProduto"/>

                                <Button
                                    Content="Cadastrar Produto"
                                    Width="160"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnCadastroProduto"/>

                            </StackPanel>

                            <!-- Grid -->
                            <DataGrid
                                Name="gridProdutos"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                RowHeight="32"
                                FontSize="14"
                                HeadersVisibility="Column"
                                BorderThickness="0"
                                Background="Transparent">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                                    <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                                    <DataGridTextColumn Header="Unidade de Medida" Binding="{Binding UnidadeDeMedida}" Width="1.4*"/>
                                    <DataGridTextColumn Header="Grupo" Binding="{Binding ProdutoGrupo}" Width="*"/>
                                    <DataGridTextColumn Header="Preço de Custo" Binding="{Binding PrecoCusto}" Width="1.1*"/>
                                    <DataGridTextColumn Header="Preço de Venda" Binding="{Binding PrecoVenda}" Width="1.1*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </TabItem>

                    <!-- TAB VENDA -->
                    <TabItem Header="Venda" FontSize="18" FontWeight="Bold">

                        <Grid Margin="10">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,15">

                                <Button
                                    Content="Consultar Vendas"
                                    Width="160"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnConsultarVenda"/>

                                <Button
                                    Content="Nova Venda"
                                    Width="140"
                                    Height="40"
                                    Margin="10"
                                    Background="#9D8BFF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="BtnNovaVendaDialog"/>

                            </StackPanel>

                            <DataGrid
                                Name="gridVendas"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                RowHeight="32"
                                Background="Transparent"
                                FontSize="14"
                                HeadersVisibility="Column"
                                BorderThickness="0">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/>
                                    <DataGridTextColumn Header="CPF" Binding="{Binding ClienteDocumento}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                                    <DataGridTextColumn Header="Data e Hora"
                                        Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm:ss}"
                                        Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Grid>

                    </TabItem>

                </TabControl>

            </Grid>

        </Border>

    </Grid>

</Window>
