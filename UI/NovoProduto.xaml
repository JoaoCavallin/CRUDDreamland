<Window x:Class="UI.NovoProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novo Produto"
        Height="550" Width="720"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Background>
        <ImageBrush ImageSource="/Copy of DreamLand.png"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="20">

        <!-- LINHAS -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0 -->
            <RowDefinition Height="Auto"/>
            <!-- 1 -->
            <RowDefinition Height="Auto"/>
            <!-- 2 -->
            <RowDefinition Height="Auto"/>
            <!-- 3 -->
            <RowDefinition Height="Auto"/>
            <!-- 4 -->
            <RowDefinition Height="Auto"/>
            <!-- 5 -->
            <RowDefinition Height="Auto"/>
            <!-- 6 -->
            <RowDefinition Height="Auto"/>
            <!-- 7 -->
            <RowDefinition Height="Auto"/>
            <!-- 8 -->
            <RowDefinition Height="*"/>
            <!-- 9 -->
        </Grid.RowDefinitions>

        <!-- COLUNAS -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- NOME -->
        <Label Content="Nome"/>
        <TextBox Name="boxNome" Grid.Row="1" Margin="0,5,10,10"/>

        <!-- MARCA -->
        <Label Content="Marca" Grid.Column="1"/>
        <TextBox Name="boxMarca" Grid.Row="1" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- DESCRIÇÃO -->
        <Label Content="Descrição" Grid.Row="2"/>
        <TextBox Name="boxDescricao" Grid.Row="3" Margin="0,5,10,10"/>

        <!-- CÓDIGO DE BARRAS -->
        <Label Content="Código de Barras" Grid.Row="2" Grid.Column="1"/>
        <TextBox Name="boxCodBarras" Grid.Row="3" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- PREÇOS -->
        <Label Content="Preço de Venda" Grid.Row="4"/>
        <TextBox Name="boxPrecoVenda" Grid.Row="5" Margin="0,5,10,10"/>

        <Label Content="Preço de Custo" Grid.Row="4" Grid.Column="1"/>
        <TextBox Name="boxPrecoCusto" Grid.Row="5" Grid.Column="1" Margin="0,5,0,10"/>

        <!-- ESTOQUE -->
        <Label Content="Quantidade em Estoque" Grid.Row="6"/>
        <TextBox Name="boxEstoque" Grid.Row="7" Margin="0,5,10,10"/>

        <!-- ENUMS + TAMANHO -->
        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10">

            <StackPanel Width="150" Margin="0,0,10,0">
                <Label Content="Categoria"/>
                <ComboBox Name="boxCategoria"/>
            </StackPanel>

            <StackPanel Width="150" Margin="0,0,10,0">
                <Label Content="Gênero"/>
                <ComboBox Name="boxGenero"/>
            </StackPanel>

            <StackPanel Width="150" Margin="0,0,10,0">
                <Label Content="Condição"/>
                <ComboBox Name="boxCondicao"/>
            </StackPanel>

            <StackPanel Width="100">
                <Label Content="Tamanho"/>
                <TextBox Name="boxTamanho"/>
            </StackPanel>

        </StackPanel>

        <!-- ATIVO + BOTÕES -->
        <Grid Grid.Row="9" Grid.ColumnSpan="2" Margin="0,20,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <CheckBox Name="boxAtivo"
                      Content="Produto Ativo"
                      VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" Grid.Column="1">

                <Button Content="Cancelar"
                        Width="120"
                        Margin="0,0,10,0"
                        IsCancel="True"/>

                <Button Content="Confirmar"
                        Width="120"
                        Click="btnConfimarProduto_Click"/>
            </StackPanel>

        </Grid>

    </Grid>
</Window>